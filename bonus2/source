#include  <stdio.h>
#include  <string.h>
#include  <stdlib.h>


int global_flag = 0;

void greetuser(char *user_input)
{
    char buffer[72]; 

    if (global_flag == 0)
        strcpy(buffer, "Hello ");
    else if (global_flag == 1)
        strcpy(buffer, "Hyv\xc3\xa4\xc3\xa4 p\xc3\xa4iv\xc3\xa4\xc3\xa4 ");
    else if (global_flag == 2)
        strcpy(buffer, "Goedemiddag ");

    strcat(buffer, user_input);
    puts(buffer);
}

int main(int argc, char **argv)
{
    char buffer[72];
    char *env;
    int ret;

    if (argc != 3)
        return 1;

    memset(buffer, 0, 72);
	
    strncpy(buffer, argv[1], 40);

	strncpy(&buffer[40], argv[2], 32);

    env = getenv("LANG");

    if (env != NULL)
    {
        if (memcmp(env, "fi", 2) == 0)
        {
            global_flag = 1;
        }
        else if (memcmp(env, "nl", 2) == 0)
        {
            global_flag = 2;
        }
    }

    // call function
    greetuser(buffer);

    return 0;
}