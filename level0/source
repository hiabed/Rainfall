#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

int main(int argc, char **argv)
{
    int value = atoi(argv[1]);

    if (value != 423)
    {
        printf("Error\n");
    }
    else
    {
        gid_t gid = getegid(); // Get the effective group ID of the current process
        uid_t uid = geteuid(); // Get the effective user ID of the current process

        setresgid(gid, gid, gid); // Set the real, effective, and saved group IDs to the effective group ID
        setresuid(uid, uid, uid); // Set the real, effective, and saved user IDs to the effective user ID

        char *args[] = {"/bin/sh", NULL};
        execv("/bin/sh", args);
    }

    return 0;
}