#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void p(void)
{
    char buffer[0x4c];   // 76 bytes (from lea -0x4c(%ebp))
    int saved_value;

    fflush(stdout);

    gets(buffer);  // ⚠️ unsafe input

    // equivalent of: mov 0x4(%ebp), %eax
    saved_value = *(int *)((char *)&buffer + 0x4c + 4);
    // (conceptually: it's reading caller return-related data)

    // apply bitmask check
    if ((saved_value & 0xb0000000) == 0xb0000000)
    {
        printf("%s", (char *)0x8048620, saved_value);
        exit(1);
    }

    puts(buffer);
    strdup(buffer);
}

int main(void)
{
    // stack alignment: and $0xfffffff0, %esp
    p();
    return 0;
}